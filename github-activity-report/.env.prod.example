# Copy to .env and fill in. Every .env* file is gitignored except this example.
#
#   cp .env.prod.example .env
#
# Blueprint commands run from dome/ with `--env-file ../.env`, so nothing needs
# to be exported by hand. The export prefixes below are for the direct-run case,
# where `source .env` is how these reach the process.
#
# Two kinds of value live here, and they are needed at different moments:
#
#   * Credentials, read only by `dome blueprint apply`, and only when it has to
#     CREATE the connection or model that holds them. A workspace that already
#     has both needs neither — Dome holds them, and apply reads nothing.
#   * Run-time configuration, read by every language runtime. The Blueprint supplies
#     every environment-specific one under runtime.environment.defaults, so
#     `dome blueprint run` needs only what you want to differ from those.

# ── Credentials: only if apply must create the resource ──────────────────────
# `dome blueprint assess` tells you which of these it needs, by name, as a
# blocker — before it attempts anything. If it reports the workspace half
# satisfied, leave both unset.

# The model provider's RAW API key — not a header value. A model connection's
# secret and a tool connection's secret are different shapes; the platform adds
# the provider's own header around this one. Match the provider the workspace
# document declares (claude-sonnet is an Anthropic connection). A workspace that
# already has this connection does not need the key at all.
# export ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# GitHub token, as a COMPLETE Authorization header value, for GitHub's hosted
# MCP server.
#
# Give it the least it can do. A fine-grained token needs only read access to
# Contents, Issues, Pull requests and Metadata on the repositories below. A
# classic token has no read-only equivalent for private repositories — `repo`
# grants write too — so prefer the fine-grained kind. For public repositories,
# `public_repo` alone is enough.
#
# The agent cannot write to GitHub regardless: dome/dome-agent.yaml entitles two read
# tools and denies everything else. That guardrail binds the agent, not the
# token, so anything else holding this value still has whatever it grants.
# export GITHUB_MCP_TOKEN="Bearer github_pat_REPLACE-ME"

# ── Run time ─────────────────────────────────────────────────────────────────
# The GitHub login whose work is being reported. Declared required in the
# Blueprint, so `dome blueprint run` will not start without it. This is not the
# token's identity — it is whose activity the report is about.
export GITHUB_USERNAME=REPLACE-ME

# Slack destination. Private repository titles end up in this channel, so pick
# it as deliberately as you picked the token's scope. Not required by the
# Blueprint: each runtime rejects OUTPUT_MODE=slack without them, by name, so a first
# OUTPUT_MODE=stdout run needs no Slack app at all.
export SLACK_BOT_TOKEN=xoxb-REPLACE-ME
export SLACK_CHANNEL=C0REPLACEME

# ── Optional: override what the Blueprint already supplies ───────────────────
# Anything set here wins over runtime.environment.defaults, so one line is
# enough to keep a first run out of Slack.
# export OUTPUT_MODE=stdout
# export LOOKBACK_HOURS=24     # --lookback-hours overrides it for one run
# export GITHUB_REPOS=dome-systems/prod-dome,dome-systems/sdk-dome-python
#
# The workspace's own names for what the gateway routes. Tools are addressed
# connection/tool and both halves are case-sensitive; `dome tool list` and
# `dome model list` show the spellings that workspace actually uses.
# export SUMMARY_MODEL=claude-sonnet
# export GITHUB_PR_SEARCH_TOOL=GitHub/search_pull_requests
# export GITHUB_ISSUE_LIST_TOOL=GitHub/list_issues

# ── Do NOT set these ─────────────────────────────────────────────────────────
# DOME_GATEWAY_URL, DOME_API_URL, DOME_WORKSPACE_ID and DOME_AGENT_ID are
# injected by `dome blueprint run` from the applied Blueprint. Setting them by
# hand is how you end up pointed at the wrong workspace.
#
# DOME_AGENT_API_KEY is the exception, and belongs here once
# `run --provision-key --write-key-to ../.env` has written it: a key that persists is
# a key that does not have to be rotated on every run.
#
# DOME_API_URL is the control plane. The agent key arrives as an envelope that has
# to be exchanged there for a gateway-scoped token, so a direct run outside
# `dome blueprint run` must supply it alongside DOME_GATEWAY_URL.
