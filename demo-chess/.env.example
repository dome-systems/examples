# Stockfish backends (pick one) — local fallback when Dome is unset
STOCKFISH_MODE=wasm
# STOCKFISH_URL=http://localhost:8080

# --- Dome ---
# Use a current Dome CLI and the workspace you configured for this example.
#
# Norms this demo teaches:
# 1) Discover tools via Gateway tools/list (+ act-as) — do NOT hardcode tool names.
# 2) Coach voice lives on chess-coach agent metadata (prompt.club / prompt.beginner),
#    resolved from the signed-in user's act-as groups. Sync with:
#      ./scripts/sync-coach-metadata.sh
#    Or set DOME_API_URL + DOME_PLATFORM_TOKEN (agent.view) for live GetAgent.
#
# DOME_GATEWAY_URL=https://gateway.dev.domesystems.ai/gateways/<gateway-id>
# DOME_COACH_TOKEN=dome_...          # from: dome agents create-key chess-coach --name local-dev
# DOME_OPPONENT_TOKEN=dome_...       # from: dome agents create-key opponent-stockfish --name local-dev
# DOME_ACTAS_SECRET=...              # HMAC secret used at chess-coach registration
# DOME_COACH_POOL=pool/coach
# DOME_OPPONENT_POOL_BEGINNER=pool/chess-fast
# DOME_OPPONENT_POOL_CLUB=pool/chess-balanced
# DOME_OPPONENT_POOL_MASTER=pool/chess-strong
# DOME_API_URL=https://api.dev.domesystems.ai
# DOME_PLATFORM_TOKEN=...            # optional platform key with agent.view
# DOME_COACH_AGENT_ID=<uuid>         # from: dome agents get chess-coach
#
# Expose local /mcp to Dome:
#   cloudflared tunnel --url http://127.0.0.1:3003
#   dome tool update stockfish --url https://<tunnel>/mcp
#   dome tool catalog sync stockfish
AUTH_SESSION_SECRET=demo-chess-dev-secret
